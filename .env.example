# BotFather'dan aldiginiz token
TELEGRAM_BOT_TOKEN=

# npm run get-chat-id ile bulacaginiz chat id
TELEGRAM_CHAT_ID=

# Takip edilecek cuzdanlar: adres:etiket, virgulle ayrilir
# Ornek: WALLETS=0x1234...abcd:Ahmet,0xabcd...5678:Mehmet
WALLETS=

# Kac saniyede bir kontrol edilsin (varsayilan 30)
POLL_INTERVAL_SECONDS=30

# Bu tutarin altindaki islemler icin bildirim gonderilmesin (varsayilan 0 = hepsi)
MIN_USDC_SIZE=0

# Durum dosyasinin kaydedilecegi yol (kalici disk mount noktasi ile eslesmeli)
STATE_PATH=./data/state.json

# Kagit (paper) trading uygulanacak cuzdan adresleri, virgulle ayrilir.
# WALLETS listesindeki bir adres burada da geciyorsa, o cuzdan icin ham
# islem bildirimi yerine pozisyon buyuklugune gore kademeli kagit trading
# calisir.
PAPER_TRADING_WALLETS=

# Kagit portfoyun baslangic bakiyesi
PAPER_START_BALANCE=380

# Kagit portfoy durum dosyasinin yolu
PAPER_STATE_PATH=./data/paper-portfolio.json
